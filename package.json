{
  "name": "bionet-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A lab's freezer, kept by the people in the lab: works offline, syncs when online.",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "try-app": "vite build && node scripts/try-app.mjs",
    "local": "node scripts/local-packages.mjs on",
    "local:off": "node scripts/local-packages.mjs off",
    "local:status": "node scripts/local-packages.mjs"
  },
  "dependencies": {
    "@biolibs/bionet-agent": "^0.1.5",
    "@biolibs/bionet-client": "^0.2.7",
    "@biolibs/bionet-demo": "^0.1.7",
    "@biolibs/bionet-panels": "^0.3.9",
    "@biolibs/bionet-react": "^0.2.0",
    "@biolibs/bionet-scene": "^0.3.7",
    "@biolibs/bionet-theme": "^0.1.0",
    "@biolibs/bionet-tools": "^0.1.10",
    "@biolibs/glossary-react": "^0.1.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5",
    "electron": "45.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vite": "^7"
  },
  "license": "MIT"
}
